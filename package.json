{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "A modern expense tracking web application",
  "private": true,
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run frontend\"",
    "frontend": "cd frontend && npm start",
    "server": "node legacy/server.js",
    "migrate": "node legacy/migrate.js",
    "build": "cd frontend && npm run build",
    "test": "cd frontend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "NODE_ENV=test DB_NAME=expense_tracker_test DB_PORT=5433 npx jest --config jest.backend.config.js",
    "test:all": "npm run test:backend && npm run test:frontend",
    "docker:up": "docker-compose up -d postgres",
    "docker:down": "docker-compose down",
    "docker:test:up": "docker-compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker-compose -f docker-compose.test.yml down",
    "start:full": "./start.sh",
    "install:all": "npm install && cd frontend && npm install && cd ../legacy && npm install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "lefthook": "^2.1.4",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  }
}
