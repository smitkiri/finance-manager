{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "A modern expense tracking web application",
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "clsx": "^2.0.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "lucide-react": "^0.263.1",
    "multer": "^2.0.2",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-day-picker": "^9.13.2",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "react-scripts": "5.0.1",
    "react-toastify": "^11.0.5",
    "recharts": "^2.8.0",
    "tailwind-merge": "^2.0.0",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:backend": "NODE_ENV=test DB_NAME=expense_tracker_test DB_PORT=5433 npx jest --config jest.backend.config.js",
    "test:frontend": "react-scripts test",
    "test:all": "npm run test:backend && npm run test:frontend",
    "docker:test:up": "docker-compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker-compose -f docker-compose.test.yml down",
    "eject": "react-scripts eject",
    "server": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run start\"",
    "start:full": "./start.sh",
    "migrate": "node migrate.js",
    "docker:up": "docker-compose up -d postgres",
    "docker:down": "docker-compose down",
    "deploy-local": "npm run build && serve -s build -l 3001",
    "serve-prod": "serve -s build -l 3001",
    "lint": "eslint src/ routes/ helpers/ --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{js,json}\" \"routes/**/*.js\" \"helpers/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{js,json}\" \"routes/**/*.js\" \"helpers/**/*.js\"",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.0",
    "lefthook": "^2.1.4",
    "postcss": "^8.4.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.3.0"
  }
}
